# Copy to backend/.env and fill in.
NVIDIA_API_KEY=nvapi-your-key-here
REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b
EXTRACTION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1   (point at a self-hosted NIM for on-prem)

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./crime_investigation.db
ALLOWED_ORIGINS=http://localhost:5173
# INVITE_CODES=AGENCY-2026   (comma-separated; when set, sign-up requires one)
# ENVIRONMENT=production

# ---- Billing (Razorpay) ----
# Test keys: dashboard.razorpay.com > Account & Settings > API Keys (Test Mode works before KYC).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Webhooks > add https://<your-api>/api/billing/webhook with the subscription.* events
RAZORPAY_WEBHOOK_SECRET=
# Prices in rupees. Plans are created in Razorpay automatically on first checkout.
PRO_MONTHLY_PRICE_INR=2900
PRO_YEARLY_PRICE_INR=20000
# Emails that always get Pro (you, pilot agencies billed by invoice)
PRO_EMAILS=
